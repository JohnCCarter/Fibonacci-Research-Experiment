{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/on_glm_session.py",
        "timeout": 15
      },
      {
        "command": "python .cursor/hooks/on_qwen_session.py",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python .cursor/hooks/on_qwen_prompt.py",
        "matcher": "UserPromptSubmit",
        "timeout": 10
      }
    ]
  }
}
